# URL base da API usada pelo front.
# Dev: "/api" — o Vite repassa /api para API_URL (proxy, sem CORS).
# Produção: URL absoluta da API, ex.: "https://minha-api.com/api"
#   (a API precisa liberar CORS para o domínio do front: URL_FRONTEND na webApi).
VITE_API_URL="/api"
VITE_ENVIRONMENT_NAME="local"

# Só para o proxy do Vite em dev (npm run dev / npm run preview). Não vai para o bundle.
API_URL="http://localhost:4000"
