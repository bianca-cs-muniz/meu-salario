# No Neon: DATABASE_URL = endereço com "-pooler" (usado pelo app); DIRECT_URL = o mesmo endereço sem "-pooler" (usado pelo prisma migrate).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meu_salario"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/meu_salario"
JWT_SECRET="troque-por-uma-string-secreta-aleatoria"
JWT_EXPIRES_IN="30d"
PORTA=4000
URL_FRONTEND="http://localhost:3000"
TZ="America/Sao_Paulo"

# --- Telegram (estagiário) — opcional. Sem as três, /api/telegram responde 503 e o resto da API funciona.
# Token do bot criado no @BotFather (segredo: nunca commitar).
TELEGRAM_BOT_TOKEN=""
# Segredo que o Telegram manda no header X-Telegram-Bot-Api-Secret-Token: 1 a 256 caracteres A-Z, a-z, 0-9, _ ou -.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=""
# Usuário do bot, sem @ (ex.: MeuSalarioBot). Usado no link https://t.me/<bot>?start=<código>.
TELEGRAM_BOT_USERNAME=""

# --- Claude — opcional. O bot lê o formato fixo por regras; o Claude só entra como reserva para texto livre.
# Sem a chave, o Telegram funciona e mensagens fora do formato recebem o molde "debito farmacia 2,90".
# Opcional. Chave da API do Claude (segredo: nunca commitar).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Só para o script `npm run telegram:webhook` (endereço público da API, com https, sem /api no fim).
URL_API_PUBLICA=""

# --- WhatsApp: reservado (não usado por enquanto).
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_API_VERSION="v21.0"
